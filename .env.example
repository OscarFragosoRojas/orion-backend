# Base de datos
DATABASE_URL=postgresql://user:password@localhost:5432/orion_db

# Cloudflare R2
R2_ACCOUNT_ID=tu-account-id-de-cloudflare
R2_BUCKET_NAME=rag-bucket
R2_ACCESS_KEY_ID=tu-r2-access-key-id
R2_SECRET_ACCESS_KEY=tu-r2-secret-access-key

# URL pública del bucket (actívala en Cloudflare Dashboard → R2 → tu bucket → Public Access)
# Puede ser el dominio r2.dev generado o tu dominio propio:
# R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
# R2_PUBLIC_URL=https://archivos.tudominio.com
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
